<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\GameRefs.props" />

  <PropertyGroup>
    <AssemblyName>Melvor2Tweaks</AssemblyName>
    <RootNamespace>Melvor2Tweaks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Remote\web\index.html" LogicalName="Melvor2Tweaks.Remote.web.index.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared at runtime from the game's load context (loaded once by the patched game). -->
    <ProjectReference Include="..\Melvor2Loader\Melvor2Loader.csproj" Private="false" GlobalPropertiesToRemove="Deploy" />
  </ItemGroup>

  <!-- dotnet build -p:Deploy=true copies the mod into <GameDir>\mods; the loader hot-reloads it if the game is running. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(ModsDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pdb" DestinationFolder="$(ModsDir)" />
    <!-- dll last: its change is what triggers the reload -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(ModsDir)" />
  </Target>
</Project>
